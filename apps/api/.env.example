PORT=8080
GOOGLE_CLOUD_PROJECT=voxian-shift-app
# Local Postgres from docker-compose.yml (pnpm db:up). On Cloud Run the API reaches
# Cloud SQL voxian-db through the Cloud SQL connector instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/voxian

# Frontend origin accepted by chat routes (set public web origin on deployment).
WEB_ORIGIN=http://localhost:3000
# gemini = Gemini Developer API / Google AI Studio credentials (current production provider).
# Billing depends on project/key tier and usage; do not assume free access.
# vertex = optional Gemini on Vertex AI via service account/ADC, no API key.
# Switch only intentionally with scripts/ai-provider.sh; see docs/ai-provider.md.
CHAT_PROVIDER=gemini
# Used only when CHAT_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used only when CHAT_PROVIDER=vertex.
VERTEX_MODEL=gemini-2.5-flash
# Optional legacy/local provider; not selected in production.
ROOTSYS_API_KEY=
ROOTSYS_MODEL=glm-5.3-flashx

# CV retrieval: off (default), shadow (measure without pruning evidence), active (prune).
# Vertex gemini-embedding-001 uses ADC/service-account auth independently of CHAT_PROVIDER.
# Run db:migrate and cv:seed-vectors first. Keep production off until retrieval gate passes.
CV_VECTOR_MODE=off
CV_EMBEDDING_REGION=us-central1
