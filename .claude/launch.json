{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--dir", "apps/web", "dev", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "api-vertex",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "CHAT_PROVIDER=vertex",
        "GOOGLE_CLOUD_PROJECT=voxian-shift-app",
        "pnpm",
        "--dir",
        "apps/api",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "web-local-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_BASE_URL=http://localhost:8080",
        "pnpm",
        "--dir",
        "apps/web",
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000
    }
  ]
}
